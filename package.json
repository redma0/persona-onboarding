{
  "name": "persona-onboarding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:agents": "node --env-file=.env.local scripts/setup-agent.mjs && node --env-file=.env.local scripts/setup-phone-agent.mjs",
